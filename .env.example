# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL — Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/blood_donation?schema=public"

# Redis (optional — caching / rate limiting, Upstash in production)
REDIS_URL="redis://default:password@localhost:6379"

# Gmail app password (optional — transactional email via Nodemailer)
GOOGLE_APP_PASSWORD=

# JWT (Day 2 — Auth)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Google OAuth (Day 2 — Social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Stripe (Day 4 — Payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
STRIPE_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
